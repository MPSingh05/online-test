# Copy this file to .env and fill in your values.

# Administrator email address(es), comma-separated, and their password. Administrators manage the Library
# (courses and documents) and the Users page. Nobody can sign in until ADMIN_EMAIL is set; without
# ADMIN_PASSWORD, administrators sign in with an emailed code instead. Never commit real values.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Claude API key used to write questions. Without it the app falls back to a basic offline generator.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Email for invites and sign-in codes. Without SMTP_HOST, emails are printed in the server console instead.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your address, SMTP_PASS=an app password
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false             # true for port 465
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Practice Test Portal <tests@example.com>

# Address put in invite emails. Set it to the portal's public address when users are on other machines.
# APP_URL=http://localhost:3000

# Optional settings
# PORT=3000
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=high            # effort for writing questions: low | medium | high | xhigh | max
# CLAUDE_EXTRACT_EFFORT=medium  # effort for reading question papers
# QUESTION_ENGINE=offline       # force the offline generator even when a key is set
# DATA_DIR=data                 # where documents, tests, results, users and sessions are stored
